# SignalScope — Environment Variables Example
# -------------------------------------------
# Copy this file to .env and fill in values for your environment.
# The .env file is gitignored and must NEVER be committed.
#
# Usage:
#   cp .env.example .env
#   # edit .env with your actual values

# --------------------------------------------------------------
# Flask
# --------------------------------------------------------------
# Environment: development | testing | production
FLASK_ENV=development

# Secret key used by Flask for session signing.
# Generate a strong random value for production:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-strong-random-secret-key

# Port the Flask API listens on
PORT=5000

# --------------------------------------------------------------
# CORS
# Comma-separated list of allowed frontend origins.
# --------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --------------------------------------------------------------
# Model
# Path to trained model weights (relative to project root).
# Populated in the model training milestone.
# --------------------------------------------------------------
MODEL_WEIGHTS_PATH=model/weights/signalscope.h5
